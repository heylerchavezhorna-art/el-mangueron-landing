{
  // Configuración de despliegue en Cloudflare (Workers con assets estáticos).
  // Despliegue manual: npx wrangler deploy
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "el-mangueron",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
